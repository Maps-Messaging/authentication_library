<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.mapsmessaging.examples</groupId>
  <artifactId>authentication-library-examples</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <authentication.version>3.1.0-SNAPSHOT</authentication.version>
  </properties>
  <repositories>
    <repository>
      <id>maps_snapshots</id>
      <url>https://repository.mapsmessaging.io/repository/maps_snapshots/</url>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>io.mapsmessaging</groupId>
      <artifactId>authentication_library</artifactId>
      <version>${authentication.version}</version>
    </dependency>
    <!-- These are declared in the library's snapshot profile; make the example's runtime explicit. -->
    <dependency>
      <groupId>io.mapsmessaging</groupId>
      <artifactId>simple_logging</artifactId>
      <version>2.3.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>io.mapsmessaging</groupId>
      <artifactId>configuration_library</artifactId>
      <version>1.2.0-SNAPSHOT</version>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
      </plugin>
    </plugins>
  </build>
</project>
